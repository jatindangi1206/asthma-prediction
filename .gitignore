__pycache__/
*.pyc
.venv/
venv/
*.zip

# ---------------------------------------------------------------------------
# data/ is never committed: patient HRV and clinical exacerbation records.
#
#   raw/pass1/   the input cohort (221 patients) — sensitive
#   processed/   ingest output + labels_pass1.csv — sensitive
#   runs/        the artifact store (current results + provenance)
#   reports/     regenerable figures and HTML
#   logs/        per-step run logs
#   old/         everything from previous runs (see data/old/README.md)
#
# There is deliberately NO demo-patient allowlist. The previous one kept patient
# 0010, who came from the retired spark export, so it cannot survive the reset to
# pass1. After the fresh run, pick a pass1 patient and allowlist it here if you want
# the repo to carry a runnable example — note that any such file is real patient data.
# ---------------------------------------------------------------------------
/data/*
# Exception: cohort-level smoothing results only (no patient ids, no readings).
# The dashboard, patient_stats.json and metrics_per_patient.csv stay out — they are per-patient.
!/data/reports/
/data/reports/*
!/data/reports/smoothing/
/data/reports/smoothing/*
!/data/reports/smoothing/cohort_stats.json
!/data/reports/smoothing/ideal_reference.json
!/data/reports/smoothing/methods.html
!/data/reports/smoothing/metrics_summary.csv
!/data/reports/smoothing/runs.csv
!/data/reports/smoothing/settings.csv
!/data/reports/smoothing/settings.json
